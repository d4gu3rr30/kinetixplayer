{
  "name": "kinetixplayer",
  "productName": "Kinetix",
  "description": "Kinetix — музыкальный плеер с синхронными текстами и офлайн-коллекцией",
  "author": "Kinetix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.mjs",
    "build": "tsc && vite build",
    "test:accounts": "node scripts/test-accounts.mjs",
    "preview": "node --env-file-if-exists=.env server/index.mjs",
    "desktop": "npm run build && electron .",
    "desktop:tools": "node scripts/prepare-tools.mjs",
    "desktop:build": "npm run desktop:tools && npm run build && electron-builder --win nsis",
    "desktop:dir": "npm run desktop:tools && npm run build && electron-builder --win dir",
    "android:build": "node scripts/build-android.mjs",
    "ios:build": "node scripts/build-ios.mjs",
    "ios:ipa": "node scripts/build-ios.mjs --unsigned"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "ffmpeg-static": "^5.3.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "google-auth-library": "^11.3.3",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "build": {
    "appId": "app.kinetix.player",
    "productName": "Kinetix",
    "copyright": "Kinetix",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json",
      "!**/*.map"
    ],
    "asar": false,
    "extraResources": [
      {
        "from": "tools",
        "to": "tools",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Kinetix-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Kinetix",
      "uninstallDisplayName": "Kinetix",
      "deleteAppDataOnUninstall": false
    }
  }
}
